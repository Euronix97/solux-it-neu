/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Strict-Transport-Security: max-age=15552000
  Cross-Origin-Opener-Policy: same-origin

/check.ps1
  Content-Type: text/plain; charset=utf-8
  Cache-Control: no-cache

/Solux-PC-Check.cmd
  Content-Type: application/octet-stream
  Content-Disposition: attachment; filename="Solux-PC-Check.cmd"
  Cache-Control: no-cache

# Bilder mit Hash oder Datum im Namen: ein Jahr im Browser behalten.
# Wer so ein Bild austauscht, muss ihm einen NEUEN Dateinamen geben (sonst sehen Besucher das alte).
/solux-bild-*
  Cache-Control: public, max-age=31536000, immutable

/solux-foto-*
  Cache-Control: public, max-age=31536000, immutable

/solux-demo-*
  Cache-Control: public, max-age=31536000, immutable

/solux-marcel-*
  Cache-Control: public, max-age=31536000, immutable

/solux-logo-*
  Cache-Control: public, max-age=31536000, immutable

/solux-favicon-*
  Cache-Control: public, max-age=31536000, immutable

/solux-touch-icon-*
  Cache-Control: public, max-age=31536000, immutable

/solux-linkvorschau-*
  Cache-Control: public, max-age=31536000, immutable
